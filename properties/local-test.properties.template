# Copy this file to properties/local-test.properties (gitignored, never committed) and
# fill in real values, to run default.sh by hand against a real environment instead of
# through a k8s Job. Only used for local/manual test runs - see default.sh's "Script
# starts from here" section for exactly how these override the printenv-derived defaults.
#
# Leave a key blank/absent to fall back to the normal printenv-derived value for that one.

# URL = idauthentication + keymanager (the "regular" API host), e.g.
# https://api-internal.<env>.mosip.net
URL=

# AUTHMANAGER_URL = authmanager only. Defaults to $URL if left blank - some cross-env
# setups run authmanager on its own instance separate from idauthentication/keymanager;
# only set this if that's actually the case for your environment.
AUTHMANAGER_URL=

# PMS_URL = partnermanager + policymanager. Defaults to $URL if left blank (fine for
# single-domain deployments) - some cross-env setups split this onto its own PMS
# instance (e.g. a separate pmp-*.<env>.mosip.net host), in which case it must be set
# explicitly here. Don't confuse URL/AUTHMANAGER_URL/PMS_URL with each other; a "Method
# Not Allowed" failure on a specific request is usually one of these pointed at the
# wrong host.
PMS_URL=

KEYCLOAK_URL=
EXTERNAL_URL=

KEYCLOAK_ADMIN_USERNAME=
KEYCLOAK_ADMIN_PASSWORD=
# This one covers mosip_deployment_client_secret's role (used for the "cert-manager"
# authenticate-with-client-credentials calls) - set here, not as mosip_deployment_client_secret.
KEYCLOAK_CLIENT_SECRET=

# No KEYCLOAK_*-style override exists for this one - default.sh reads it directly by this
# exact underscore name inside each module's dispatch block, so it must be set here as-is.
mosip_pms_client_secret=
